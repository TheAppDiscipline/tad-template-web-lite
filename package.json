{
  "name": "tad-template-web-lite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheAppDiscipline/tad-template-web-lite.git"
  },
  "homepage": "https://github.com/TheAppDiscipline/tad-template-web-lite#readme",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
